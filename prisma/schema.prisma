generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  OWNER
  DRIVER
  ADMIN
}

enum OwnerType {
  INDIVIDUAL
  BUSINESS
}

enum VerificationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DriverAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  ON_DUTY
  ASSIGNED
  OFF_DUTY
}

enum IncidentCategory {
  ACCIDENT
  BREAKDOWN
  THEFT
  DAMAGE
  LATE_RETURN
  DRIVER_MISCONDUCT
  CUSTOMER_COMPLAINT
  SAFETY_EMERGENCY
  PAYMENT_DISPUTE
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  ACTION_REQUIRED
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  BOOKING
  PAYMENT
  CANCELLATION
  VEHICLE_CONDITION
  OWNER_BEHAVIOUR
  DRIVER_BEHAVIOUR
  REFUND
  TECHNICAL
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum VehicleCategory {
  CAR
  BIKE
  SCOOTER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  CNG
  HYBRID
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

enum VehicleComplianceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum RentalType {
  SELF_DRIVE
  CHAUFFEUR
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  AWAITING_PAYMENT
  CONFIRMED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum DocumentCategory {
  RC
  COMMERCIAL_PERMIT
  INSURANCE
  PUC
  FITNESS
  OTHER
}

enum DocumentStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  REPLACED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
}

enum InspectionType {
  PICKUP
  RETURN
}

model User {
  id            String               @id @default(uuid())
  fullName      String
  email         String               @unique
  phone         String               @unique
  passwordHash  String
  accountStatus String               @default("ACTIVE")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  roles         UserRoleAssignment[]
  ownerProfile  OwnerProfile?
  driverProfile DriverProfile?
  vehicles      Vehicle[]            @relation("UserVehicles")
  bookings      Booking[]            @relation("CustomerBookings")
  reviews       Review[]             @relation("CustomerReviews")
  auditLogs     AuditLog[]           @relation("UserAuditLogs")
  notifications Notification[]
  documentAccessLogs DocumentAccessLog[]

  @@index([email])
  @@index([phone])
}

model UserRoleAssignment {
  id         String   @id @default(uuid())
  userId     String
  role       UserRole
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model OwnerProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  ownerType          OwnerType @default(INDIVIDUAL)
  businessName       String?
  verificationStatus String    @default("VERIFIED")
  createdAt          DateTime  @default(now())

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DriverProfile {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  licenceVerificationStatus String   @default("VERIFIED")
  availabilityStatus        String   @default("AVAILABLE")
  createdAt                 DateTime @default(now())

  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Vehicle {
  id                 String                  @id @default(uuid())
  ownerId            String
  category           VehicleCategory
  make               String
  model              String
  registrationNumber String                  @unique
  manufacturingYear  Int
  fuelType           FuelType                @default(PETROL)
  transmission       Transmission            @default(MANUAL)
  seatingCapacity    Int                     @default(5)
  description        String?                 @db.Text
  location           String
  latitude           Float?
  longitude          Float?
  dailyRentalPrice   Float
  driverCharge       Float?                  @default(0)
  selfDriveEnabled   Boolean                 @default(true)
  chauffeurEnabled   Boolean                 @default(false)
  approvalStatus     ApprovalStatus          @default(PENDING)
  complianceStatus   VehicleComplianceStatus @default(PENDING_REVIEW)
  rejectionReason    String?
  availabilityStatus AvailabilityStatus      @default(AVAILABLE)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  owner              User                    @relation("UserVehicles", fields: [ownerId], references: [id], onDelete: Cascade)
  images             VehicleImage[]
  documents          VehicleDocument[]
  documentVersions   VehicleDocumentVersion[]
  bookings           Booking[]
  reviews            Review[]

  @@index([ownerId])
  @@index([approvalStatus, availabilityStatus])
  @@index([category])
  @@index([location])
}

model VehicleImage {
  id        String   @id @default(uuid())
  vehicleId String
  imageUrl  String   @db.Text
  imageType String   @default("EXTERIOR")
  createdAt DateTime @default(now())

  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehicleDocument {
  id                 String           @id @default(uuid())
  vehicleId          String
  documentType       String
  category           DocumentCategory @default(RC)
  expiryDate         DateTime?
  verificationStatus String           @default("VERIFIED")
  status             DocumentStatus   @default(APPROVED)
  fileKey            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  vehicle            Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  versions           VehicleDocumentVersion[]

  @@index([vehicleId])
}

model VehicleDocumentVersion {
  id           String           @id @default(uuid())
  vehicleId    String
  documentId   String?
  category     DocumentCategory
  fileKey      String
  originalName String
  mimeType     String
  fileSize     Int
  status       DocumentStatus   @default(PENDING_REVIEW)
  rejectionReason String?
  expiryDate   DateTime?
  uploadedBy   String
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  document     VehicleDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  accessLogs   DocumentAccessLog[]

  @@index([vehicleId])
  @@index([category, status])
}

model DocumentAccessLog {
  id         String   @id @default(uuid())
  documentVersionId String
  userId     String
  action     String   @default("VIEW")
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    VehicleDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([documentVersionId])
  @@index([userId])
}

model Booking {
  id              String                 @id @default(uuid())
  customerId      String
  vehicleId       String
  rentalType      RentalType             @default(SELF_DRIVE)
  pickupDateTime  DateTime
  returnDateTime  DateTime
  pickupLocation  String
  dropLocation    String
  basePrice       Float
  driverCharge    Float                  @default(0)
  serviceFee      Float                  @default(0)
  securityDeposit Float                  @default(0)
  totalAmount     Float
  status          BookingStatus          @default(REQUESTED)
  expiresAt       DateTime?
  rejectionReason String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  customer        User                   @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  vehicle         Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  statusHistory   BookingStatusHistory[]
  payments        Payment[]
  priceSnapshot   BookingPriceSnapshot?
  inspections     BookingInspection[]
  review          Review?

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([pickupDateTime, returnDateTime])
}

model BookingPriceSnapshot {
  id                  String   @id @default(uuid())
  bookingId           String   @unique
  currency            String   @default("INR")
  baseRentalPricePaise Int
  durationDays        Int
  dailyRatePaise      Int
  chauffeurFeePaise   Int      @default(0)
  extraKmChargePaise  Int      @default(0)
  serviceFeePaise     Int      @default(0)
  estimatedTaxPaise   Int      @default(0)
  securityDepositPaise Int     @default(0)
  totalPayablePaise   Int
  formattedInr        String
  quotedAt            DateTime @default(now())

  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingStatusHistory {
  id             String   @id @default(uuid())
  bookingId      String
  previousStatus String?
  newStatus      String
  changedBy      String
  note           String?
  createdAt      DateTime @default(now())

  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id                   String          @id @default(uuid())
  bookingId            String
  provider             PaymentProvider @default(MOCK)
  providerOrderId      String?
  providerPaymentId    String?
  amount               Float
  amountPaise          Int             @default(0)
  currency             String          @default("INR")
  paymentMethod        String
  paymentStatus        PaymentStatus   @default(COMPLETED)
  transactionReference String          @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt

  booking              Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds              Refund[]

  @@index([bookingId])
  @@index([providerOrderId])
}

model PaymentWebhookEvent {
  id                 String          @id @default(uuid())
  provider           PaymentProvider @default(RAZORPAY)
  eventId            String          @unique
  eventType          String
  payloadReference   String?         @db.Text
  signatureVerified  Boolean         @default(false)
  processingStatus   String          @default("PROCESSED") // PROCESSED, FAILED, DUPLICATE
  processedAt        DateTime        @default(now())

  @@index([eventId])
  @@index([eventType])
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String
  amountPaise      Int
  formattedAmount  String
  reason           String?
  status           String   @default("COMPLETED")
  providerRefundId String   @unique
  createdAt        DateTime @default(now())

  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model BookingInspection {
  id              String         @id @default(uuid())
  bookingId       String
  inspectionType  InspectionType
  odometerReading Int
  fuelLevelPercent Int
  vehicleCondition String
  visibleDamage   String?
  inspectorId     String
  submittedAt     DateTime       @default(now())

  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items           InspectionItem[]
  media           InspectionMedia[]

  @@unique([bookingId, inspectionType])
  @@index([bookingId])
}

model InspectionItem {
  id           String            @id @default(uuid())
  inspectionId String
  component    String // 'TYRES', 'LIGHTS', 'BODY_PANELS', 'INTERIOR'
  statusOk     Boolean           @default(true)
  notes        String?

  inspection   BookingInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model InspectionMedia {
  id           String            @id @default(uuid())
  inspectionId String
  mediaUrl     String            @db.Text
  caption      String?
  createdAt    DateTime          @default(now())

  inspection   BookingInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  customerId String
  vehicleId  String
  rating     Int
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer   User     @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([customerId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  actor      User?    @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
}

model BusinessOrganisation {
  id                 String             @id @default(uuid())
  businessName       String
  businessType       String             // PVT_LTD, LLP, PARTNERSHIP, PROPRIETORSHIP
  registeredAddress  String
  panNumber          String?
  gstin              String?
  contactPerson      String
  contactEmail       String
  contactPhone       String
  verificationStatus VerificationStatus @default(NOT_STARTED)
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members            FleetMember[]
  locations          FleetLocation[]
  assignments        FleetVehicleAssignment[]
}

model FleetMember {
  id          String               @id @default(uuid())
  orgId       String
  userId      String
  role        String               @default("STAFF") // OWNER, FLEET_MANAGER, DISPATCHER, STAFF
  permissions String               @default("VIEW_FLEET,MANAGE_BOOKINGS")
  createdAt   DateTime             @default(now())

  organisation BusinessOrganisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model FleetLocation {
  id                 String               @id @default(uuid())
  orgId              String
  name               String
  address            String
  city               String
  postalCode         String
  latitude           Float?
  longitude          Float?
  contactPerson      String
  contactNumber      String
  operatingHours     String               @default("08:00 - 20:00")
  pickupInstructions String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())

  organisation       BusinessOrganisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments        FleetVehicleAssignment[]

  @@index([orgId])
  @@index([city])
}

model FleetVehicleAssignment {
  id           String               @id @default(uuid())
  vehicleId    String               @unique
  orgId        String
  locationId   String?
  assignedAt   DateTime             @default(now())

  organisation BusinessOrganisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location     FleetLocation?       @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([locationId])
}

model OwnerVerificationApplication {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  ownerType              OwnerType          @default(INDIVIDUAL)
  currentStep            Int                @default(1)
  status                 VerificationStatus @default(NOT_STARTED)
  fullName               String
  email                  String
  mobile                 String
  address                String?
  profilePhotoUrl        String?
  idVerificationMethod   String?            // MANUAL_PASSPORT, MANUAL_VOTER_ID, MANUAL_PAN
  idVerificationRef      String?            // Synthetic/mock reference ID
  bankAccountHolder      String?
  bankVerificationStatus String             @default("PENDING") // PENDING, VERIFIED, FAILED
  bankVerificationRef    String?
  payoutEligible         Boolean            @default(false)
  termsAccepted          Boolean            @default(false)
  termsVersion           String?            @default("v1.2")
  termsAcceptedAt        DateTime?
  submittedAt            DateTime?
  reviewedBy             String?
  reviewedAt             DateTime?
  rejectionReason        String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
}

model AdministrativeReview {
  id             String   @id @default(uuid())
  entityType     String   // OWNER, VEHICLE, DRIVER, DOCUMENT, INCIDENT, DISPUTE
  entityId       String
  adminId        String
  action         String   // APPROVE, REJECT, REQUEST_INFO, SUSPEND, RESOLVE
  previousStatus String?
  newStatus      String
  reason         String   @db.Text
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
}

model ExtendedDriverProfile {
  id                        String                   @id @default(uuid())
  userId                    String                   @unique
  fullName                  String
  phone                     String
  email                     String
  address                   String?
  licenceCategory           String                   @default("LMV") // LMV, HMV, MCWG
  licenceNumber             String?
  licenceVerificationStatus VerificationStatus       @default(NOT_STARTED)
  backgroundScreeningStatus VerificationStatus       @default(NOT_STARTED)
  employmentType            String                   @default("CONTRACTOR") // FULL_TIME, PART_TIME, CONTRACTOR
  orgId                     String?
  availabilityStatus        DriverAvailabilityStatus @default(AVAILABLE)
  currentLatitude           Float?
  currentLongitude          Float?
  rating                    Float                    @default(5.0)
  totalTrips                Int                      @default(0)
  rejectionReason           String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  assignments               DriverTripAssignment[]

  @@index([availabilityStatus])
  @@index([orgId])
}

model DriverTripAssignment {
  id              String         @id @default(uuid())
  bookingId       String
  driverId        String
  status          String         @default("ASSIGNED") // ASSIGNED, ACCEPTED, REJECTED, STARTED, COMPLETED, CANCELLED
  tripStartTime   DateTime?
  tripEndTime     DateTime?
  startOdometer   Int?
  endOdometer     Int?
  notes           String?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  driver          ExtendedDriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([driverId])
  @@index([status])
}

model ComplianceRule {
  id                String   @id @default(uuid())
  ruleId            String   @unique
  jurisdictionState String   // e.g., 'KARNATAKA', 'MAHARASHTRA', 'DELHI'
  jurisdictionCity  String?  // Optional city specific override, e.g. 'BENGALURU'
  vehicleCategory   String   // CAR, BIKE, SCOOTER
  rentalModel       String   // SELF_DRIVE, CHAUFFEUR
  ownerCategory     String   // INDIVIDUAL, BUSINESS
  requiredDocuments String   // Comma separated: 'RC,INSURANCE,PUC'
  requiredPermits   String?  // Comma separated: 'COMMERCIAL_PERMIT,RENT_A_CAB'
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT
  effectiveDate     DateTime @default(now())
  expiryDate        DateTime?
  sourceReference   String?  // e.g., 'Motor Vehicles Act 1988, Rent a Cab Scheme 1989'
  reviewerNotes     String?  @db.Text
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  versions          ComplianceRuleVersion[]

  @@index([jurisdictionState, vehicleCategory, rentalModel])
}

model ComplianceRuleVersion {
  id            String         @id @default(uuid())
  ruleId        String
  version       Int
  changeSummary String
  changedBy     String
  snapshot      String         @db.Text // JSON string of rule state
  createdAt     DateTime       @default(now())

  rule          ComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model DocumentExpiryNotification {
  id             String    @id @default(uuid())
  entityType     String    // 'VEHICLE', 'DRIVER'
  entityId       String
  documentType   String
  expiryDate     DateTime
  daysRemaining  Int
  threshold      Int       // 30, 15, 7, 0
  notifiedAt     DateTime  @default(now())
  status         String    @default("SENT") // SENT, ACKNOWLEDGED, RESOLVED

  @@index([entityType, entityId])
  @@index([threshold, status])
}

model BookingHandover {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  completedAt       DateTime @default(now())
  verifiedBy        String
  odometerReading   Int
  fuelLevelPercent  Int
  conditionRating   String   @default("GOOD")
  notes             String?  @db.Text
  photosJson        String?  @db.Text
  customerConfirmed Boolean  @default(true)
  handoverStatus    String   @default("COMPLETED")

  @@index([bookingId])
}

model BookingReturnRecord {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  completedAt       DateTime @default(now())
  verifiedBy        String
  odometerReading   Int
  fuelLevelPercent  Int
  conditionRating   String   @default("GOOD")
  notes             String?  @db.Text
  photosJson        String?  @db.Text
  disputeRaised     Boolean  @default(false)
  disputeNotes      String?  @db.Text
  returnStatus      String   @default("COMPLETED")

  @@index([bookingId])
}

model IncidentReport {
  id                   String           @id @default(uuid())
  bookingId            String?
  reportedBy           String
  reportedByRole       String           @default("CUSTOMER") // CUSTOMER, OWNER, DRIVER, ADMIN
  vehicleId            String?
  driverId             String?
  category             IncidentCategory @default(BREAKDOWN)
  priority             IncidentPriority @default(MEDIUM)
  status               IncidentStatus   @default(OPEN)
  title                String
  description          String           @db.Text
  location             String?
  emergencyContactUsed Boolean          @default(false)
  assignedAgentId      String?
  resolutionNotes      String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  attachments          IncidentAttachment[]

  @@index([status])
  @@index([priority])
  @@index([bookingId])
}

model IncidentAttachment {
  id         String         @id @default(uuid())
  incidentId String
  fileUrl    String         @db.Text
  fileType   String         @default("IMAGE")
  caption    String?
  createdAt  DateTime       @default(now())

  incident   IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model SupportTicket {
  id              String         @id @default(uuid())
  ticketNumber    String         @unique
  raisedBy        String
  raisedByRole    String         @default("CUSTOMER")
  category        TicketCategory @default(BOOKING)
  subject         String
  description     String         @db.Text
  priority        IncidentPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  bookingId       String?
  assignedTo      String?
  resolutionNotes String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  messages        SupportMessage[]

  @@index([status])
  @@index([raisedBy])
  @@index([ticketNumber])
}

model SupportMessage {
  id          String        @id @default(uuid())
  ticketId    String
  senderId    String
  senderName  String
  senderRole  String        @default("CUSTOMER")
  message     String        @db.Text
  attachments String?       @db.Text // JSON list of file URLs
  createdAt   DateTime      @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}
