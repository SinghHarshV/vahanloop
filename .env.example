# ==============================================================================
# VahanLoop Production & Controlled Pilot Environment Configuration (.env.example)
# IMPORTANT: Copy this file to .env and provide your actual environment values.
# NEVER commit real API keys, production passwords, or secret tokens to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string to PostgreSQL instance (AWS RDS, Neon, Supabase, or local Docker).
# In production, use transaction pooler URL (e.g. port 6543 on Supabase or ?pgbouncer=true).
# If omitted or pointing to unreachable localhost, VahanLoop automatically uses its high-speed in-memory store.
DATABASE_URL="postgresql://username:password@hostname:5432/vahanloop_db?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographic secret for signing HTTP-only JWT cookies and document tokens.
# MUST be a random string of at least 32 characters (e.g. generated via `openssl rand -hex 32`).
JWT_SECRET="generate_a_random_32_character_hex_secret_key_here"

# Public URL of the web application (used for email reset links, webhooks, and absolute URLs)
NEXT_PUBLIC_APP_URL="https://vahanloop.vercel.app"

# Application environment ('development' | 'production' | 'test')
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 3. SECURE PRIVATE DOCUMENT & IMAGE STORAGE (S3-Compatible Cloud Storage)
# ------------------------------------------------------------------------------
# Supports AWS S3, Cloudflare R2, MinIO, or Supabase Storage.
# If left blank, documents are stored securely in local private storage (dev only).
S3_BUCKET_NAME=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Custom endpoint (leave blank for standard AWS S3, or set for Cloudflare R2 / MinIO)
# Example Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=""

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay – TEST MODE ONLY)
# ------------------------------------------------------------------------------
# Set to 'mock' for local offline demo, or 'razorpay' to use Razorpay test mode.
# SAFETY GUARD: The application will strictly REJECT any 'rzp_live_' keys.
PAYMENT_MODE="mock"

# Razorpay Test Credentials (from https://dashboard.razorpay.com/#/access/api_keys in Test Mode)
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayTestSecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretConfiguredInRazorpayDashboard"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Resend API Key (Recommended for Vercel: https://resend.com)
RESEND_API_KEY=""

# Sender email address displayed in outgoing notifications
EMAIL_FROM="VahanLoop Mobility <notifications@vahanloop.com>"

# Alternative: Standard SMTP Server (Used if RESEND_API_KEY is not set)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ------------------------------------------------------------------------------
# 6. SMS & WHATSAPP GATEWAY (Optional Interface for Controlled Pilot)
# ------------------------------------------------------------------------------
# Placeholder for Twilio, Gupshup, or Exotel for OTP and urgent roadside alerts
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_ID=""

# ------------------------------------------------------------------------------
# 7. SERVERLESS RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# For distributed rate-limiting across Vercel serverless edge functions.
# (If unconfigured, an in-memory sliding window fallback is used automatically)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 8. MONITORING & ERROR TRACKING
# ------------------------------------------------------------------------------
# Optional Sentry DSN for unhandled exception tracing in production
SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 9. BUSINESS RULES & OPERATIONAL TIMERS
# ------------------------------------------------------------------------------
BUSINESS_TIMEZONE="Asia/Kolkata"
RESERVATION_HOLD_MINUTES=15
