# VahanLoop Phase 3 Environment Configuration
# Connection string to PostgreSQL database
DATABASE_URL="postgresql://vahanloop_user:vahanloop_password_dev@localhost:5432/vahanloop_db?schema=public"

# JWT secret key for secure HTTP-only session cookies and signed download URLs
JWT_SECRET="vahanloop_dev_jwt_secret_key_minimum_32_chars_random_safe"

# Environment
NODE_ENV="development"
PORT=3000

# Payment Gateway Configuration (Test Mode Only)
# Supported values: mock | razorpay
PAYMENT_MODE="mock"

# Razorpay Test Credentials (Leave blank to use mock mode, NEVER use rzp_live_ keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Business Configuration
BUSINESS_TIMEZONE="Asia/Kolkata"
RESERVATION_HOLD_MINUTES=15
